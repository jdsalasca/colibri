<script lang="rust">
    let count = signal(0);
    let increment = move |_| count.update(|n| *n += 1);
</script>

<template>
    <button on:click={increment}>Count: {count}</button>
</template>

<style scoped lang="scss">
    $primary: #b72b46;
    button { background: $primary; color: white; }
</style>
